+package com.init.kwave.catalog;
+
+import com.init.kwave.artist.controller.ArtistV1Controller;
+import com.init.kwave.artist.service.ArtistService;
+import com.init.kwave.song.controller.SongV1Controller;
+import com.init.kwave.song.service.SongService;
+import com.init.kwave.common.exception.GlobalExceptionHandler;
+import org.junit.jupiter.api.Test;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import java.util.List;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+class KPopFilterControllerTest {
+    private final ArtistService artistService = mock(ArtistService.class);
+    private final SongService songService = mock(SongService.class);
+    private final MockMvc mvc = MockMvcBuilders.standaloneSetup(
+            new ArtistV1Controller(artistService), new SongV1Controller(songService))
+            .setControllerAdvice(new GlobalExceptionHandler()).build();
+
+    @Test void generationIsPassedToServiceAndInvalidValuesAreRejected() throws Exception {
+        when(artistService.getArtists(any(Pageable.class), eq("4세대"), eq("en"))).thenReturn(Page.empty(org.springframework.data.domain.PageRequest.of(0, 20)));
+        mvc.perform(get("/api/v1/artists").param("generation", "4세대").param("sort", "popularity"))
+                .andExpect(status().isOk());
+        verify(artistService).getArtists(any(Pageable.class), eq("4세대"), eq("en"));
+        mvc.perform(get("/api/v1/artists").param("generation", "not-a-generation")).andExpect(status().isBadRequest());
+    }
+
+    @Test void ostAndGenreAreCombinedAndBooleanDefaultsToFalse() throws Exception {
+        when(songService.getSongs(any(Pageable.class), nullable(String.class), nullable(String.class), anyBoolean(), eq("en"))).thenReturn(Page.empty(org.springframework.data.domain.PageRequest.of(0, 20)));
+        mvc.perform(get("/api/v1/songs").param("genre", "ballad").param("mood", "CALM").param("ostOnly", "true"))
+                .andExpect(status().isOk());
+        verify(songService).getSongs(any(Pageable.class), eq("Ballad"), eq("calm"), eq(true), eq("en"));
+        mvc.perform(get("/api/v1/songs")).andExpect(status().isOk());
+        verify(songService).getSongs(any(Pageable.class), isNull(), isNull(), eq(false), eq("en"));
+        mvc.perform(get("/api/v1/songs").param("ostOnly", "bad")).andExpect(status().isBadRequest());
+    }
+
+    @Test void metadataAdvertisesOnlySupportedFilters() throws Exception {
+        when(artistService.getGenerations()).thenReturn(List.of("3세대", "4세대"));
+        mvc.perform(get("/api/v1/artists/filters")).andExpect(status().isOk())
+                .andExpect(jsonPath("$.data.generation").value(true))
+                .andExpect(jsonPath("$.data.generations[1]").value("4세대"));
+        mvc.perform(get("/api/v1/songs/filters")).andExpect(status().isOk())
+                .andExpect(jsonPath("$.data.ostOnly").value(true));
+    }
+}

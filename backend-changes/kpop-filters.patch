+package com.init.kwave.catalog;
+
+import com.init.kwave.artist.entity.Artist;
+import com.init.kwave.artist.repository.ArtistRepository;
+import com.init.kwave.artist.repository.ArtistSpecifications;
+import com.init.kwave.content.entity.Category;
+import com.init.kwave.content.entity.Subcategory;
+import com.init.kwave.content.entity.Content;
+import com.init.kwave.content.entity.ContentRelation;
+import com.init.kwave.song.entity.Song;
+import com.init.kwave.song.repository.SongRepository;
+import com.init.kwave.song.repository.SongSpecifications;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.orm.jpa.DataJpaTest;
+import org.springframework.boot.test.autoconfigure.orm.jpa.TestEntityManager;
+import org.springframework.boot.test.autoconfigure.jdbc.AutoConfigureTestDatabase;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.data.domain.Sort;
+import java.time.LocalDate;
+import static org.assertj.core.api.Assertions.assertThat;
+
+@DataJpaTest(properties = {
+    "spring.flyway.enabled=false", "spring.jpa.hibernate.ddl-auto=create-drop",
+    "spring.datasource.url=jdbc:h2:mem:filters;MODE=MySQL;DB_CLOSE_DELAY=-1",
+    "spring.datasource.driver-class-name=org.h2.Driver",
+    "spring.datasource.username=sa", "spring.datasource.password="
+})
+@AutoConfigureTestDatabase(replace = AutoConfigureTestDatabase.Replace.NONE)
+class KPopFilterRepositoryTest {
+    @Autowired TestEntityManager em;
+    @Autowired ArtistRepository artists;
+    @Autowired SongRepository songs;
+    private Subcategory subcategory;
+
+    private Content content() {
+        if (subcategory == null) {
+            Category category = em.persist(Category.builder().code("MUSIC").build());
+            subcategory = em.persist(Subcategory.builder().category(category).code("SONG").build());
+        }
+        return em.persist(Content.builder().subcategory(subcategory).build());
+    }
+
+    private Artist artist(String name, String generation, boolean group) {
+        return em.persist(Artist.builder().content(content()).name(name)
+                .externalArtistId(name).isGroup(group).generation(generation).build());
+    }
+
+    private Song song(Artist artist, String title, String genre) {
+        Song song = Song.builder().content(content()).artist(artist).title(title)
+                .externalMusicId(title).releaseDate(LocalDate.of(2020, 1, 1)).build();
+        song.updateGenreMood(genre, null, null, "calm", null);
+        return em.persist(song);
+    }
+
+    private void link(int source, Song song, String type) {
+        em.persist(ContentRelation.builder().sourceContentId(source)
+                .targetContentId(song.getContent().getContentId()).relationType(type).build());
+    }
+
+    @Test void generationFiltersBeforePagingAndIncludesClassifiedSoloIdols() {
+        artist("Group4", "4세대", true);
+        artist("Solo4", "4세대", false);
+        artist("Group3", "3세대", true);
+        artist("Singer", null, false);
+        em.flush();
+        var page = artists.findAll(ArtistSpecifications.hasGeneration("4세대"),
+                PageRequest.of(0, 1, Sort.by("artistId")));
+        assertThat(page.getTotalElements()).isEqualTo(2);
+        assertThat(page.getTotalPages()).isEqualTo(2);
+        assertThat(page.getContent()).extracting(Artist::getName).containsExactly("Group4");
+        assertThat(artists.findAll(ArtistSpecifications.hasGeneration("4세대"),
+                PageRequest.of(1, 1, Sort.by("artistId"))).getContent())
+                .extracting(Artist::getName).containsExactly("Solo4");
+        assertThat(artists.findGenerations()).containsExactly("3세대", "4세대");
+    }
+
+    @Test void ostRelationsFilterWithoutDuplicatesAndComposeWithGenreAndPopularity() {
+        Artist artist = artist("Artist", null, false);
+        Song ost = song(artist, "Theme", "Ballad");
+        ost.updateLastfmListeners(100);
+        Song second = song(artist, "Theme2", "Dance");
+        Song ordinary = song(artist, "Ordinary OST in title", "Ballad");
+        link(content().getContentId(), ost, "OST_OF");
+        link(content().getContentId(), ost, "OST_OF");
+        link(content().getContentId(), second, "OST_OF");
+        link(content().getContentId(), ordinary, "RELATED");
+        em.flush();
+        var all = songs.findAll(SongSpecifications.isOst(),
+                PageRequest.of(0, 1, Sort.by("songId")));
+        assertThat(all.getTotalElements()).isEqualTo(2);
+        assertThat(all.getTotalPages()).isEqualTo(2);
+        var combined = songs.findAll(SongSpecifications.isOst()
+                        .and(SongSpecifications.hasGenreMain("Ballad"))
+                        .and(SongSpecifications.hasMoodMain("calm"))
+                        .and(SongSpecifications.orderByPopularity(false)),
+                PageRequest.of(0, 24));
+        assertThat(combined.getTotalElements()).isEqualTo(1);
+        assertThat(combined.getContent()).extracting(Song::getTitle).containsExactly("Theme");
+    }
+
+    @Test void emptyResultsHaveZeroTotals() {
+        assertThat(songs.findAll(SongSpecifications.isOst(), PageRequest.of(0, 24)).getTotalElements()).isZero();
+        assertThat(artists.findAll(ArtistSpecifications.hasGeneration("5세대"), PageRequest.of(0, 24)).getTotalElements()).isZero();
+    }
+}

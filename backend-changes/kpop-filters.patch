+    // Use the same video -> song OST_OF relation as VideoOstRepository; EXISTS avoids duplicate songs.
+    public static Specification<Song> isOst() {
+        return (root, query, cb) -> {
+            Subquery<Integer> ost = query.subquery(Integer.class);
+            Root<ContentRelation> relation = ost.from(ContentRelation.class);
+            ost.select(cb.literal(1)).where(
+                    cb.equal(relation.get("targetContentId"), root.get("content").get("contentId")),
+                    cb.equal(relation.get("relationType"), "OST_OF"));
+            return cb.exists(ost);
+        };
+    }
+
     // 대표 장르(genre_main)가 같은 곡
     public static Specification<Song> hasGenreMain(String genreMain) {
         return (root, query, cb) -> cb.equal(root.get("genreMain"), genreMain);
     }
 
